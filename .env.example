# Copy this file to .env and fill in your values. Never commit .env.

# Primary model (DeepSeek). Current names (Nov 2026): deepseek-flash (cheap, default) or deepseek-v4-pro.
# The old names deepseek-chat / deepseek-reasoner were retired on 24 Jul 2026.
LLM_BASE_URL="https://api.deepseek.com"
LLM_MODEL="deepseek-flash"
# Or leave this out and save the key in secrets/deepseek.txt (git-ignored).
LLM_API_KEY="sk-your-deepseek-api-key"
# V4 models "think" by default (extra paid output tokens); our prompts already ask for reasoning, so it is off.
LLM_THINKING="disabled"
# Deep mode (mode=deep): the analyst, bull, bear, judge and reviewer steps use thinking at this effort (low/high/max).
LLM_DEEP_EFFORT="high"
# Optional: run the judgement steps (analyst, bull, bear, judge, reviewer, forecast, scenarios, brief) and the deep
# writer on another model of the same API, e.g. deepseek-v4-pro (prices 9 Nov 2026: ~4.5x flash for input, ~3.4x for
# output). Empty = the primary model.
LLM_DEEP_MODEL=""
# Optional, per step (empty = as above): the simple report's writer and the learner notes; the writers' thinking
# effort (low / high / max); the claim check's model (flash is enough for checking sentences against sources).
LLM_WRITER_MODEL=""
LLM_WRITER_EFFORT=""
LLM_CHECK_MODEL=""

# Backup model, used automatically if the primary fails. Any OpenAI-compatible API works, e.g.
#   GLM (Zhipu):   LLM_FALLBACK_BASE_URL="https://open.bigmodel.cn/api/paas/v4"           LLM_FALLBACK_MODEL="glm-4.6"
#   Qwen (Alibaba): LLM_FALLBACK_BASE_URL="https://dashscope.aliyuncs.com/compatible-mode/v1" LLM_FALLBACK_MODEL="qwen-plus"
#   Kimi (Moonshot): LLM_FALLBACK_BASE_URL="https://api.moonshot.cn/v1"                   LLM_FALLBACK_MODEL="kimi-k2"
# (model names change; check the provider's docs)
LLM_FALLBACK_BASE_URL=""
LLM_FALLBACK_MODEL=""
LLM_FALLBACK_API_KEY=""

# Finnhub (free key at finnhub.io): US company news going back weeks. Either set it here or keep it in
# secrets/finnhub.txt (git-ignored). Free plan covers US/North-American symbols only.
FINNHUB_API_KEY=""

# Commentary: "single" (one AI call) or "two_step" (Concept -> Thesis, FinRobot-style)
NARRATIVE_MODE="single"
# Peers when config/peers.json has no list for a ticker: ai (AI picks same-business-model peers, reasons shown) | auto
PEER_MODE="ai"
# Research desk: reads results releases, announcements, broker reports (A-shares) and news before writing
# (~40 cheap flash calls, about RMB 0.2 per stock off-peak; shared by that day's simple/deep/learner runs).
RESEARCH=1
RESEARCH_CHUNKS=60
# News outlets: keep news only from the outlets in config/news_sources.json (the report's news list, the writers
# and the research desk). 0 = old behaviour (only content farms are blocked).
NEWS_ALLOWLIST=1
# Analyst question bank (config/question_bank.json): the AI picks the most relevant questions and may add up to 3
# from recent news; shown as homework in standard / learner, answered in deep. 0 = off.
QUESTIONS=1
# Claim check: each risky sentence is checked against the sources before publishing (thinking calls).
CLAIM_CHECK=1
# Its thinking effort (empty = LLM_DEEP_EFFORT), sentences checked per pass, and the optional passes
# (learner notes, deep debate, second pass over rewritten sentences); 0 skips a pass.
LLM_CHECK_EFFORT=""
CLAIM_CHECK_LIMIT=48
CLAIM_CHECK_LEARNER=1
CLAIM_CHECK_DEBATE=1
CLAIM_CHECK_FINAL=1
GUARDRAIL_ATTEMPTS=3
# House forecast (AI drivers, P&L in code, vs consensus): 1 = on
FORECAST=1
# Analyst brief before the simple report is written (central question, pillars, quality, governance, gap to
# brokers; one thinking call) and a worked example of a strong page 1 on another company: 1 = on
BRIEF=1
# What sets the AI rating's fair value: rule = weighted blend of DCF and peer multiples (config/rating.json);
# scenarios = same blend with our scenario DCF in the DCF's place; analyst = our probability-weighted bear/base/bull
# value alone, peers and the mechanical DCF shown as cross-checks (default since 9 Nov 2026; "rule" without AI).
RATING_BASIS="analyst"
# Page-1 "overall view" blending the AI rating with broker ratings (off since 9 Nov 2026; page 1 shows the Street
# separately). 1 = show it.
OVERALL_VIEW=0
# US companies: cash (incl. current marketable debt securities, not equity stakes) and debt from SEC XBRL filings
SEC_FACTS=1

# Latest annual / interim reports (SEC EDGAR, HKEXnews, CNINFO)
FILINGS_ENABLED=1
FILINGS_TIMEOUT_SECONDS=300
# SEC EDGAR requires a contact address in the User-Agent of automated requests
SEC_USER_AGENT="InvestSync Research Tools investsyncofficial@gmail.com"

CACHE_DB_PATH="data/cache.sqlite3"
# CORS_ORIGINS="https://your-club-website.example"
